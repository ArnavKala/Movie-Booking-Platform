PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/movie_booking?replicaSet=rs0
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
RAZORPAY_TEST_API_KEY=rzp_test_replace_me
RAZORPAY_TEST_API_SECRET=replace_me
# Optional for local development; set this to the secret configured in Razorpay webhooks.
RAZORPAY_WEBHOOK_SECRET=
# QR tickets link to this frontend URL. Use a reachable LAN/HTTPS URL for phone scanning.
PUBLIC_APP_URL=http://localhost:5173
# Cloudinary signed uploads for admin movie artwork and trailers.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=goodshow/movies
